<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Stats.StatsFragment">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:background="@color/neutral">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ================= Route Card ================= -->

            <androidx.cardview.widget.CardView
                android:id="@+id/routeCard"
                android:layout_width="match_parent"
                android:layout_height="260dp"
                android:layout_marginBottom="18dp"
                app:cardBackgroundColor="#181818"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">


                    <org.osmdroid.views.MapView
                        android:id="@+id/statsMapView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clickable="false"
                        android:focusable="false"
                        android:focusableInTouchMode="false"
                        android:duplicateParentState="true"
                        android:importantForAccessibility="no" />


                    <TextView
                        android:id="@+id/sessionLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|start"
                        android:layout_marginStart="16dp"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/session_chip_background"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        android:text="SESSION : ALPHA-7"
                        android:textAllCaps="true"
                        android:textColor="@color/secondary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </FrameLayout>

            </androidx.cardview.widget.CardView>

            <!-- ================= Stats Row ================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <!-- Distance Card -->

                <androidx.cardview.widget.CardView
                    android:id="@+id/distanceCard"
                    android:layout_width="0dp"
                    android:layout_height="130dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#23251B">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="DISTANCE"
                            android:textColor="@color/secondary"
                            android:textStyle="bold"
                            android:textSize="12sp"
                            android:letterSpacing="0.08" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:gravity="bottom">

                            <TextView
                                android:id="@+id/tvDistance"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="10.0"
                                android:textColor="@color/primary"
                                android:textStyle="bold"
                                android:textSize="42sp" />

                            <TextView
                                android:id="@+id/tvDistanceUnit"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="KM"
                                android:textColor="@color/tertiary"
                                android:textSize="18sp"
                                android:layout_marginBottom="6dp"/>

                        </LinearLayout>

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <!-- Duration Card -->

                <androidx.cardview.widget.CardView
                    android:id="@+id/durationCard"
                    android:layout_width="0dp"
                    android:layout_height="130dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#1D1D1D">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="DURATION"
                            android:textColor="@color/secondary"
                            android:textStyle="bold"
                            android:textSize="12sp"
                            android:letterSpacing="0.08"/>

                        <TextView
                            android:id="@+id/tvTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="48:20"
                            android:textColor="@color/tertiary"
                            android:textStyle="bold"
                            android:textSize="40sp"/>

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

            </LinearLayout>


            <!-- ================= Average Pace ================= -->

            <androidx.cardview.widget.CardView
                android:id="@+id/paceCard"
                android:layout_width="match_parent"
                android:layout_height="112dp"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#1D1D1D">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AVG PACE"
                        android:textColor="@color/secondary"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:letterSpacing="0.08"/>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="bottom">

                        <TextView
                            android:id="@+id/tvPace"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="4:50"
                            android:textColor="@color/tertiary"
                            android:textStyle="bold"
                            android:textSize="46sp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="/KM"
                            android:textColor="@color/tertiary"
                            android:textSize="18sp"
                            android:layout_marginStart="6dp"
                            android:layout_marginBottom="7dp"/>

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>




                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="KM Splits"
                    android:fontFamily="@font/space"
                    android:textColor="@color/faded_primary"
                    android:paddingStart="30dp"
                    android:layout_marginTop="20dp"
                    android:letterSpacing="0.15"/>

                <androidx.recyclerview.widget.RecyclerView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="0dp"
                    android:id="@+id/recycler"/>



            <TextView
                android:id="@+id/tvChartTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DISTANCE RUN"
                android:layout_marginTop="30dp"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp"/>

            <!-- Timeframe Tabs -->
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/timeframeTabLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#00000000"
                app:tabTextColor="#888888"
                app:tabSelectedTextColor="#C6FF00"
                app:tabIndicatorColor="#C6FF00"
                android:layout_marginBottom="16dp">

                <com.google.android.material.tabs.TabItem
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="WEEK" />

                <com.google.android.material.tabs.TabItem
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MONTH" />

                <com.google.android.material.tabs.TabItem
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="YEAR" />
            </com.google.android.material.tabs.TabLayout>

            <!-- Bar Chart for Daily/Monthly Totals -->
            <com.github.mikephil.charting.charts.BarChart
                android:id="@+id/statsBarChart"
                android:layout_width="match_parent"
                android:layout_height="300dp" />

            </LinearLayout>
        </ScrollView>
</FrameLayout>