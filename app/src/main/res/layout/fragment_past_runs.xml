<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".PastRuns.PastRunsFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/neutral">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="10dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="PACELOCK"
                        android:textColor="@color/primary"
                        android:fontFamily="@font/space"
                        android:textSize="40sp"
                        android:paddingStart="24dp"
                        android:textStyle="italic" />


                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginTop="5dp"
                        android:src="@drawable/ic_person"/>


                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:background="#5C5C5C"/>


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:paddingStart="25dp"
                        android:layout_marginTop="40dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="HISTORY"
                            android:textColor="@color/secondary"
                            android:fontFamily="@font/lexend"
                            android:textSize="17dp"
                            />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ACTIVITY"
                            android:textColor="@color/tertiary"
                            android:fontFamily="@font/space"
                            android:textSize="35dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:paddingStart="25dp"
                        android:layout_marginTop="40dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="TOTAL DISATNCE"
                            android:textColor="@color/faded_primary"
                            android:fontFamily="@font/lexend"
                            android:textSize="17dp"
                            />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="148.4"
                                android:fontFamily="@font/space"
                                android:textColor="@color/primary"
                                android:paddingStart="20dp"
                                android:textSize="35dp"
                                />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="KM"
                                android:textColor="@color/faded_primary"
                                android:textStyle="bold"
                                android:paddingStart="3dp"/>

                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="20dp"
                    app:strokeWidth="2dp"
                    android:backgroundTint="@color/card_bg"
                    android:layout_marginTop="30dp"
                    app:strokeColor="@color/faded_primary">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:padding="5dp"
                            android:src="@drawable/ic_search"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="FILTER RUNS..."
                            android:textColor="#8AA3A68F"
                            android:fontFamily="@font/lexend"
                            android:layout_gravity="center"
                            android:textSize="17dp"
                            />


                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <androidx.recyclerview.widget.RecyclerView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="35dp"
                    android:layout_marginHorizontal="20dp"
                    android:layout_weight="1"/>

            </LinearLayout>
</FrameLayout>