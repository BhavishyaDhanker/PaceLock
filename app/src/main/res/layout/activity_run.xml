<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:background="@drawable/bg_run"
    tools:context=".Run.RunActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ================= HEADER ================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="86dp"
                android:background="#1B1B1B"
                android:gravity="center_vertical"
                android:paddingHorizontal="18dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/logo"
                        app:tint="@color/primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="PACELOCK"
                        android:textColor="@color/primary"
                        android:textSize="30sp"
                        android:textStyle="italic"
                        android:fontFamily="@font/space" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ELAPSED"
                        android:textColor="@color/faded_primary"
                        android:textSize="14sp"
                        android:fontFamily="@font/space"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="12:45"
                        android:textColor="@android:color/white"
                        android:textSize="28sp"
                        android:fontFamily="@font/space" />

                </LinearLayout>

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#3A3A3A" />

            <!-- ================= MAP CARD ================= -->

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="260dp"
                android:layout_marginHorizontal="22dp"
                android:layout_marginTop="28dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="8dp"
                app:strokeColor="#5B5B5B"
                app:strokeWidth="1dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <org.osmdroid.views.MapView
                        android:id="@+id/mapView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|start"
                        android:layout_margin="16dp"
                        android:background="@drawable/bg_live_tracking"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="10dp"
                        android:text="LIVE TRACKING ACTIVE"
                        android:textAllCaps="true"
                        android:textColor="#16E7FF"
                        android:textSize="13sp"
                        android:fontFamily="@font/space" />

                </FrameLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ================= CURRENT PACE ================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="34dp"
                android:text="CURRENT PACE"
                android:textColor="@color/faded_primary"
                android:textSize="17sp"
                android:textStyle="bold"
                android:fontFamily="@font/space" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="bottom"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvCurrentPace"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4:32"
                    android:textColor="@color/primary"
                    android:textSize="54sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/space" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_marginBottom="10dp"
                    android:text="/km"
                    android:textColor="@android:color/white"
                    android:textSize="26sp"
                    android:fontFamily="@font/space" />

            </LinearLayout>

            <!-- ================= STATS CARDS ================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:layout_marginHorizontal="22dp"
                android:orientation="horizontal"
                android:weightSum="2">

                <!-- Distance Card -->

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="145dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="10dp"
                    app:cardBackgroundColor="@color/card_bg"
                    app:cardCornerRadius="16dp"
                    app:strokeColor="#666666"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:padding="22dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="DISTANCE"
                            android:textColor="@color/faded_primary"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/space" />

                        <TextView
                            android:id="@+id/tvDistance"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:text="2.4 km"
                            android:textColor="@android:color/white"
                            android:textSize="34sp"
                            android:fontFamily="@font/space" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Avg Pace Card -->

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="145dp"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    app:cardBackgroundColor="@color/card_bg"
                    app:cardCornerRadius="16dp"
                    app:strokeColor="#666666"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:padding="22dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="AVG PACE"
                            android:textColor="@color/faded_primary"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/space" />

                        <TextView
                            android:id="@+id/tvPace"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:text="4:40"
                            android:textColor="@android:color/white"
                            android:textSize="34sp"
                            android:fontFamily="@font/space" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

                <!-- ================= BOTTOM SPACE ================= -->

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="80dp" />

                <!-- ================= ACTION BUTTONS ================= -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="22dp"
                    android:layout_marginBottom="26dp"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <!-- Finish -->

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="82dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="12dp"
                        app:cardBackgroundColor="@color/card_bg"
                        app:cardCornerRadius="18dp"
                        app:strokeColor="#666666"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:id="@+id/finishRun"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:src="@drawable/ic_stop"
                                app:tint="#FFB5B5" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:text="FINISH"
                                android:textColor="@android:color/white"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                android:fontFamily="@font/space" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <!-- Pause -->

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="82dp"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        app:cardBackgroundColor="@color/primary"
                        app:cardCornerRadius="18dp">

                        <LinearLayout
                            android:id="@+id/pauseRun"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:src="@drawable/ic_pause"
                                app:tint="@color/neutral" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:text="PAUSE RUN"
                                android:id="@+id/tvPauseRun"
                                android:textColor="@color/neutral"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                android:fontFamily="@font/space" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

            </LinearLayout>

    </ScrollView>

</LinearLayout>