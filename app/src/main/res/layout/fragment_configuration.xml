<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".Configration.ConfigurationFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/neutral">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="10dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="PACELOCK"
            android:textColor="@color/primary"
            android:fontFamily="@font/space"
            android:textSize="40sp"
            android:paddingStart="24dp"
            android:textStyle="italic" />


        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="5dp"
            android:src="@drawable/ic_person"/>


    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="#5C5C5C"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SYSTEM PREFRENCES"
        android:fontFamily="@font/lexend"
        android:textColor="@color/primary"
        android:paddingTop="40dp"
        android:paddingStart="20dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="CONFIGURATION"
        android:textSize="35sp"
        android:fontFamily="@font/space"
        android:textColor="@color/tertiary"
        android:letterSpacing="-0.05"
        android:paddingStart="20dp"/>


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PERFORMANCE TARGETS"
            android:fontFamily="@font/lexend"
            android:textColor="@color/faded_primary"
            android:paddingTop="40dp"
            android:paddingStart="20dp"/>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="30dp"
            app:strokeWidth="2dp"
            app:strokeColor="@color/faded_primary"
            android:backgroundTint="@color/card_bg"
            android:id="@+id/paceTar">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="PACE TARGET"
            android:fontFamily="@font/space"
            android:textSize="60dp"
            android:textColor="@color/secondary"/>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="30dp"
            app:strokeWidth="2dp"
            app:strokeColor="@color/faded_primary"
            android:backgroundTint="@color/card_bg"
            android:id="@+id/cadenceTar">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="CADENCE TARGET"
                android:fontFamily="@font/space"
                android:textSize="60dp"
                android:textColor="@color/secondary"/>
        </com.google.android.material.card.MaterialCardView>


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="COACHING FEEDBACK"
            android:fontFamily="@font/lexend"
            android:textColor="@color/faded_primary"
            android:paddingTop="40dp"
            android:paddingStart="20dp"/>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="30dp"
            app:strokeWidth="2dp"
            app:strokeColor="@color/faded_primary"
            android:backgroundTint="@color/card_bg"
            android:id="@+id/vibrationToggle">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="VIBRATION"
                android:fontFamily="@font/space"
                android:textSize="60dp"
                android:textColor="@color/secondary"/>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="30dp"
            app:strokeWidth="2dp"
            app:strokeColor="@color/faded_primary"
            android:backgroundTint="@color/card_bg"
            android:id="@+id/voiceToggle">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="VOICE"
                android:fontFamily="@font/space"
                android:textSize="60dp"
                android:textColor="@color/secondary"/>
        </com.google.android.material.card.MaterialCardView>


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SYSTEM"
            android:fontFamily="@font/lexend"
            android:textColor="@color/faded_primary"
            android:paddingTop="40dp"
            android:paddingStart="20dp"/>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="30dp"
            app:strokeWidth="2dp"
            app:strokeColor="@color/faded_primary"
            android:backgroundTint="@color/card_bg"
            android:id="@+id/unitSelection">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="METRIC/ IMPERIAL"
                android:fontFamily="@font/space"
                android:textSize="60dp"
                android:textColor="@color/secondary"/>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
    </ScrollView>
    </LinearLayout>

</FrameLayout>