<?xml version="1.0" encoding="utf-8"?>

<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#111111"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <!-- ================= TITLE ================= -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="26dp"
            android:text="SYSTEM PREFERENCES"
            android:textAllCaps="true"
            android:textColor="#D4FF00"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.15" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="6dp"
            android:text="CONFIGURATION"
            android:textColor="#F2F2F2"
            android:textSize="34sp"
            android:textStyle="bold" />

        <!-- ================= SECTION ================= -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="34dp"
            android:text="◎ PERFORMANCE TARGETS"
            android:textAllCaps="true"
            android:textColor="#C9C9B8"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.15" />

        <!-- ================= PACE CARD ================= -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="18dp"
            android:layout_marginTop="18dp"
            app:cardBackgroundColor="#141414"
            app:cardCornerRadius="14dp"
            app:strokeColor="#222222"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">


                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginEnd="10dp"
                        android:src="@drawable/ic_timer"
                        app:tint="#008C95" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="PACE TARGET"
                        android:textAllCaps="true"
                        android:textColor="#00E6FF"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08" />



                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="26dp"
                    android:gravity="bottom">

                    <TextView
                        android:id="@+id/tvPaceValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="4:30"
                        android:textColor="#F5F5F5"
                        android:textSize="60sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_marginBottom="12dp"
                        android:text="MIN/KM"
                        android:textAllCaps="true"
                        android:textColor="#C8C8B5"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderPace"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:value="270"
                    android:valueFrom="180"
                    android:valueTo="540"
                    app:haloColor="#66D4FF00"
                    app:thumbColor="#D4FF00"
                    app:trackColorActive="#505050"
                    app:trackColorInactive="#3A3A3A" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="18dp"
            android:layout_marginTop="18dp"
            app:cardBackgroundColor="#141414"
            app:cardCornerRadius="14dp"
            app:strokeColor="#222222"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">


                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_target"
                        android:layout_marginEnd="10dp"
                        app:tint="#008C95" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="PACE TOLERANCE"
                        android:textAllCaps="true"
                        android:textColor="#00E6FF"
                        android:textSize="15sp"
                        android:textStyle="bold" />



                </LinearLayout>

                <TextView
                    android:id="@+id/tvTolerance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:text="±8 seconds"
                    android:textColor="#F5F5F5"
                    android:textSize="36sp"
                    android:textStyle="bold" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderTolerance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:stepSize="1"
                    android:value="8"
                    android:valueFrom="2"
                    android:valueTo="20"
                    app:thumbColor="#D4FF00"
                    app:trackColorActive="#505050"
                    app:trackColorInactive="#3A3A3A" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="18dp"
            android:layout_marginTop="18dp"
            app:cardBackgroundColor="#141414"
            app:cardCornerRadius="14dp"
            app:strokeColor="#222222"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_calender"
                        android:layout_marginEnd="10dp"
                        app:tint="#008C95"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="WEEKLY TARGET"
                        android:textAllCaps="true"
                        android:textColor="#00E6FF"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08"/>



                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="26dp"
                    android:gravity="bottom">

                    <TextView
                        android:id="@+id/tvWeeklyTarget"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="25"
                        android:textColor="#F5F5F5"
                        android:textSize="60sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_marginBottom="12dp"
                        android:text="KM"
                        android:textAllCaps="true"
                        android:textColor="#C8C8B5"
                        android:textSize="18sp"
                        android:textStyle="bold"/>

                </LinearLayout>

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderWeeklyTarget"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:value="25"
                    android:valueFrom="5"
                    android:valueTo="150"
                    android:stepSize="1"
                    app:thumbColor="#D4FF00"
                    app:trackColorActive="#505050"
                    app:trackColorInactive="#3A3A3A"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- ================= CADENCE CARD ================= -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="18dp"
            android:layout_marginTop="18dp"
            app:cardBackgroundColor="#141414"
            app:cardCornerRadius="14dp"
            app:strokeColor="#222222"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">


                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_cadence"
                        android:layout_marginEnd="10dp"
                        app:tint="#008C95" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="CADENCE TARGET"
                        android:textAllCaps="true"
                        android:textColor="#00E6FF"
                        android:textSize="15sp"
                        android:textStyle="bold" />



                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="26dp"
                    android:gravity="bottom">

                    <TextView
                        android:id="@+id/tvCadence"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="180"
                        android:textColor="#F5F5F5"
                        android:textSize="60sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_marginBottom="12dp"
                        android:text="SPM"
                        android:textAllCaps="true"
                        android:textColor="#C8C8B5"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderCadence"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:value="180"
                    android:valueFrom="140"
                    android:valueTo="220"
                    app:haloColor="#66D4FF00"
                    app:thumbColor="#D4FF00"
                    app:trackColorActive="#505050"
                    app:trackColorInactive="#3A3A3A" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="20dp"
                    android:background="#2A2A2A"/>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchMetronome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Enable Metronome"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"/>

                <RadioGroup
                    android:id="@+id/radioMetronomeType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/radioSound"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sound"
                        android:textColor="#FFFFFF"/>

                    <RadioButton
                        android:id="@+id/radioVibration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="18dp"
                        android:text="Vibration"
                        android:textColor="#FFFFFF"/>

                </RadioGroup>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- ================= FEEDBACK ================= -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="40dp"
            android:text="◉ COACHING FEEDBACK"
            android:textAllCaps="true"
            android:textColor="#C9C9B8"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.15" />

        <!-- Vibration -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="18dp"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="#171717"
            app:cardCornerRadius="12dp"
            app:strokeColor="#222222">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="18dp">

                <ImageView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:src="@drawable/ic_vibration"
                    app:tint="#C5C5B5" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:text="Vibration feedback"
                        android:textColor="#FFFFFF"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:text="Haptic alerts for pace deviation"
                        android:textColor="#9F9F9F"
                        android:textSize="14sp" />

                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchVibration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Voice -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="18dp"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="#171717"
            app:cardCornerRadius="12dp"
            app:strokeColor="#222222">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="18dp">

                <ImageView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:src="@drawable/ic_voice"
                    app:tint="#C5C5B5" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:text="Voice coaching"
                        android:textColor="#FFFFFF"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:text="Real-time audio performance cues"
                        android:textColor="#9F9F9F"
                        android:textSize="14sp" />

                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchVoice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>