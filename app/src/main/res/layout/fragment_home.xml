<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Home.HomeFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/neutral">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="10dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="PACELOCK"
                        android:textColor="@color/primary"
                        android:fontFamily="@font/space"
                        android:textSize="40sp"
                        android:paddingStart="24dp"
                        android:textStyle="italic" />


                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginTop="5dp"
                        android:src="@drawable/ic_person"/>


                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:background="#5C5C5C"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="SYSTEM STATUS : OPTIMAL"
                    android:fontFamily="@font/lexend"
                    android:textColor="@color/secondary"
                    android:paddingTop="40dp"
                    android:paddingStart="20dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="LOCKED IN"
                    android:textSize="45sp"
                    android:fontFamily="@font/space"
                    android:textColor="@color/tertiary"
                    android:paddingStart="20dp"/>

                <androidx.cardview.widget.CardView
                    android:layout_width="160dp"
                    android:layout_height="160dp"
                    android:layout_gravity="center"
                    android:layout_marginTop="50dp"
                    android:id="@+id/startRun"
                    app:cardCornerRadius="16dp"
                    android:backgroundTint="@color/primary">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="START"
                            android:textColor="@color/neutral"
                            android:padding="10dp"
                            android:layout_gravity="center"
                            android:layout_marginTop="38dp"
                            android:textStyle="bold"
                            android:textSize="35sp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="RUN"
                            android:textColor="@color/neutral"
                            android:layout_gravity="center"
                            android:textSize="15sp"/>

                    </LinearLayout>


                </androidx.cardview.widget.CardView>


                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="8dp"
                    android:backgroundTint="@color/neutral"
                    android:elevation="4dp"
                    android:layout_marginTop="30dp"
                    android:layout_marginHorizontal="20dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="15dp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="WEEKLY DISTANCE"
                                android:fontFamily="@font/space"
                                android:textColor="@color/secondary"
                                android:paddingStart="20dp"
                                android:letterSpacing="0.15"/>

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="18.4"
                                android:fontFamily="@font/space"
                                android:textColor="@color/tertiary"
                                android:paddingStart="20dp"
                                android:textSize="60dp"
                                />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="KM"
                                android:textColor="@color/faded_primary"
                                android:textStyle="bold"
                                android:paddingStart="3dp"/>

                        </LinearLayout>

                        <ProgressBar
                            android:layout_width="match_parent"
                            android:layout_height="6dp"
                            android:max="100"
                            android:progress="65"
                            android:progressDrawable="@drawable/bg_progress_bar"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_marginBottom="20dp"
                            android:layout_marginHorizontal="20dp"/>
                    </LinearLayout>

                </androidx.cardview.widget.CardView>


                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="8dp"
                    android:backgroundTint="@color/neutral"
                    android:elevation="4dp"
                    android:layout_marginTop="30dp"
                    android:layout_marginHorizontal="20dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="15dp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="LAST RUN"
                                android:fontFamily="@font/space"
                                android:textColor="@color/primary"
                                android:paddingStart="20dp"
                                android:letterSpacing="0.15"/>

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="5.4"
                                android:id="@+id/tvLastRunDistance"
                                android:fontFamily="@font/space"
                                android:textColor="@color/tertiary"
                                android:layout_marginTop="15dp"
                                android:paddingStart="20dp"
                                android:textSize="45dp"
                                />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="KM"
                                android:id="@+id/tvRunUnit"
                                android:textColor="@color/faded_primary"
                                android:textStyle="bold"
                                android:layout_marginTop="15dp"
                                android:paddingStart="3dp"/>



                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:layout_marginLeft="100dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="match_parent"
                                    android:id="@+id/tvLastRunPace"
                                    android:text="4:45"
                                    android:textSize="55dp"
                                    android:textColor="@color/primary"/>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="MIN/KM"
                                    android:textColor="@color/faded_primary"
                                    android:textStyle="bold"
                                    android:textSize="18dp"
                                    android:paddingStart="30dp"/>

                            </LinearLayout>

                        </LinearLayout>

                    </LinearLayout>

                </androidx.cardview.widget.CardView>



            </LinearLayout>

        </ScrollView>


    </LinearLayout>

</FrameLayout>