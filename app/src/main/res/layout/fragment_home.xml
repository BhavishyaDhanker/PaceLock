<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Home.HomeFragment">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:background="@color/neutral">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <!-- System Status -->

            <TextView
                android:id="@+id/systemStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SYSTEM STATUS : OPTIMAL"
                android:textColor="@color/secondary"
                android:textSize="15sp"
                android:fontFamily="@font/lexend"
                android:textStyle="bold"
                android:letterSpacing="0.12"/>

            <!-- Title -->

            <TextView
                android:id="@+id/lockedTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="LOCKED IN"
                android:textColor="@color/tertiary"
                android:textSize="54sp"
                android:fontFamily="@font/space"
                android:textStyle="bold"/>

            <!-- Start Button -->

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="320dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="28dp">

                <androidx.cardview.widget.CardView
                    android:id="@+id/startRun"
                    android:layout_width="280dp"
                    android:layout_height="280dp"
                    android:layout_gravity="center"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/primary">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:id="@+id/startRunIcon"
                            android:layout_width="60dp"
                            android:layout_height="60dp"
                            android:layout_marginBottom="16dp"
                            android:src="@drawable/ic_play"
                            app:tint="@color/neutral"/>

                        <TextView
                            android:id="@+id/startRunText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="START"
                            android:textColor="@color/neutral"
                            android:textStyle="bold"
                            android:textSize="54sp"
                            android:fontFamily="@font/space"/>

                        <TextView
                            android:id="@+id/startRunSubText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="RUN"
                            android:textColor="@color/neutral"
                            android:textSize="20sp"
                            android:fontFamily="@font/lexend"
                            android:textStyle="bold"/>

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

            </FrameLayout>

            <!--================ Weekly Distance =================-->

            <androidx.cardview.widget.CardView
                android:id="@+id/weeklyDistanceCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="22dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#171717">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="22dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <ImageView
                            android:id="@+id/calendarIcon"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginEnd="10dp"
                            android:src="@drawable/ic_calender"
                            app:tint="@color/secondary"/>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="WEEKLY DISTANCE"
                            android:fontFamily="@font/space"
                            android:textColor="@color/secondary"
                            android:textStyle="bold"
                            android:textSize="14sp"
                            android:letterSpacing="0.12"/>



                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:gravity="bottom">

                        <TextView
                            android:id="@+id/tvWeeklyDistance"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="18.4"
                            android:textSize="56sp"
                            android:fontFamily="@font/space"
                            android:textColor="@color/tertiary"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=" KM"
                            android:textStyle="bold"
                            android:textColor="@color/faded_primary"
                            android:layout_marginBottom="8dp"/>

                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/weeklyDistanceProgress"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:layout_marginTop="20dp"
                        android:max="100"
                        android:progress="65"
                        android:progressDrawable="@drawable/bg_progress_bar"/>

                </LinearLayout>

            </androidx.cardview.widget.CardView>


            <!--================ Last Run =================-->

            <androidx.cardview.widget.CardView
                android:id="@+id/lastRunCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="22dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#171717">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="22dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <ImageView
                            android:id="@+id/historyIcon"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_marginEnd="10dp"
                            android:src="@drawable/ic_history"
                            app:tint="@color/faded_primary"/>


                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="LAST RUN"
                            android:textColor="@color/faded_primary"
                            android:textStyle="bold"
                            android:textSize="14sp"
                            android:fontFamily="@font/space"
                            android:letterSpacing="0.12"/>


                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp">

                        <!-- Left -->

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="horizontal"
                            android:gravity="bottom">

                            <TextView
                                android:id="@+id/tvLastRunDistance"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="5.2"
                                android:textSize="44sp"
                                android:fontFamily="@font/space"
                                android:textColor="@color/tertiary"/>

                            <TextView
                                android:id="@+id/tvRunUnit"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=" KM"
                                android:textColor="@color/faded_primary"
                                android:textStyle="bold"
                                android:layout_marginBottom="8dp"/>

                        </LinearLayout>

                        <!-- Right -->

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvLastRunPace"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="4:45"
                                android:textSize="46sp"
                                android:textColor="@color/primary"
                                android:fontFamily="@font/space"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="MIN/KM"
                                android:textStyle="bold"
                                android:textColor="@color/faded_primary"
                                android:gravity="center_horizontal"/>

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </ScrollView>

</FrameLayout>